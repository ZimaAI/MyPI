MYPI_PROFILE=public-demo
PUBLIC_EXECUTION_ENABLED=false
MYPI_ENABLE_IMPORTS=false
MYPI_ORIGIN=https://mypi.example.com
MYPI_HOST=127.0.0.1
MYPI_PORT=4100
MYPI_DATA_DIR=/var/lib/mypi/private
MYPI_BROKER_STATE=/var/lib/mypi/broker
MYPI_BROKER_SOCKET=/run/user/1000/mypi/broker.sock
MYPI_BROKER_TOKEN=
MYPI_WORKER_SOCKET=/run/user/1000/mypi/worker.sock
MYPI_WORKER_TOKEN=
MYPI_SANDBOX_IMAGE=
MYPI_SANDBOX_RUNTIME=runsc
MYPI_MASTER_KEY=
MYPI_COOKIE_SECRET=
