# Copy to .env via pnpm setup to generate independent random private credentials.
MYPI_PROFILE=local
MYPI_HOST=127.0.0.1
MYPI_PORT=3000
MYPI_ORIGIN=http://localhost:3000
MYPI_DATA_DIR=.mypi/server
MYPI_BROKER_STATE=.mypi/broker
MYPI_WORKER_URL=http://127.0.0.1:4101
MYPI_WORKER_PORT=4101
MYPI_BROKER_URL=http://127.0.0.1:4102
MYPI_BROKER_PORT=4102
MYPI_MASTER_KEY=
MYPI_COOKIE_SECRET=
MYPI_WORKER_TOKEN=
MYPI_BROKER_TOKEN=
PUBLIC_EXECUTION_ENABLED=false
MYPI_ENABLE_IMPORTS=false
MYPI_SANDBOX_RUNTIME=runsc
MYPI_SANDBOX_IMAGE=
# CLI only. Server model keys are entered in the authenticated admin model form.
# MYPI_API_KEY=
# MYPI_PROVIDER=openai
# MYPI_MODEL=gpt-4.1-mini
