# 不含真实密钥；实现真实配置加载器后再使用。
MYPI_PROFILE=public-demo
PUBLIC_EXECUTION_ENABLED=false
MYPI_PUBLIC_ORIGIN=https://mypi.example.com
MYPI_DB_PATH=/var/lib/mypi/private/mypi.db
MYPI_WORKER_SOCKET=/run/mypi/worker.sock
MYPI_BROKER_SOCKET=/run/mypi/broker.sock
# 由安全随机源生成，运行时注入，不存入工作区/源码。
MYPI_MASTER_KEY=
MYPI_COOKIE_SECRET=
# 模型 API Key 从加密配置/Secret Store 读取，不放入沙箱环境。
