{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MyPI: Broker",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/apps/execution-broker/src/main.ts",
      "runtimeArgs": ["--import", "tsx"],
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "MyPI: Worker",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/apps/worker/src/main.ts",
      "runtimeArgs": ["--import", "tsx"],
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "MyPI: Gateway",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/apps/gateway/src/main.ts",
      "runtimeArgs": ["--import", "tsx"],
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "MyPI: Web (Vite)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "args": ["--config", "apps/web/vite.config.ts"],
      "console": "internalConsole",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "startDebugging",
        "name": "MyPI: Browser",
        "pattern": "Local:\\s+(https?://\\S+:5173/)"
      }
    },
    {
      "name": "MyPI: Browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}/apps/web"
    },
    {
      "name": "MyPI: CLI",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/apps/cli/src/main.ts",
      "runtimeArgs": ["--import", "tsx"],
      "args": ["doctor"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "MyPI: Full Stack",
      "configurations": [
        "MyPI: Broker",
        "MyPI: Worker",
        "MyPI: Gateway",
        "MyPI: Web (Vite)"
      ],
      "stopAll": true
    }
  ]
}
